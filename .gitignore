# Signing key generated per machine — must never be versioned (cf. auth.py)
backend/data/.jwt_secret

# LLM provider API keys read by services/llm/keys.py. backend/data/ is NOT
# ignored as a whole — only the patterns listed here — so each secret file
# needs its own line.
backend/data/.openai_key
backend/data/.anthropic_key

# Runtime data (price store, FF series — auto-generated)
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/underlying_prices/
backend/data/whisper_models/
backend/data/fx_rates/
backend/data/ff_data/

# Claude memory (local session state, worktrees...) — but agent definitions
# under .claude/agents/ are meant to be shared with the team, keep those.
.claude/*
!.claude/agents/
!.claude/agents/**

# Temp / debug files at root
debug_*.py
AVANCEMENT.md
DECISION_ANALYSIS_ENGINE.md
MANAGER_DNA_ENGINE.md
REPRISE_TRAVAIL.md
SKILL_VS_LUCK_ENGINE.md
