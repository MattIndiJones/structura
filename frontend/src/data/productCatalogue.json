    {
      "key": "twin_win",
      "label": "Twin Win",
      "family": "capital",
      "description": "Gain sur la valeur absolue de la performance, plafonné, tant que la barrière américaine n'est pas franchie. Barrière franchie : le capital suit le worst-of.",
      "underlyings": {
        "min": 1,
        "max": 5
      },
      "tenors": [
        "1Y",
        "18M",
        "2Y",
        "3Y",
        "4Y",
        "5Y"
      ],
      "constats": {
        "MATURITYDATE": {
          "role": "maturity"
        },
        "STARTDATE": {
          "role": "initial_fixing"
        }
      },
      "script": [
        "UNDERLYING Basket",
        "",
        "# Twin Win — performance absolue plafonnée tant que la barrière n'est pas franchie",
        "PARAM CAP",
        "PARAM M_KI_BAR",
        "",
        "CONSTAT StartDate",
        "CONSTAT MaturityDate",
        "",
        "AT StartDate:",
        "  Basket.spot0 = Basket.spot@StartDate",
        "",
        "AT MaturityDate:",
        "  SET BREACHED = INDIC(WOF_MIN < M_KI_BAR)",
        "  SET UPS = MIN(CAP, MAX(1, WORSTOF(Basket.yield)))",
        "  SET DNS = MIN(CAP, MAX(1, 2 - WORSTOF(Basket.yield)))",
        "  PAY 1 \"Capital — remboursement à maturité\"",
        "  PAY (1 - BREACHED) * (MAX(UPS, DNS) - 1) \"Performance absolue plafonnée\"",
        "  PAY BREACHED * MAX(WORSTOF(Basket.yield) - 1, 0) \"Hausse après franchissement\"",
        "  PAY -BREACHED * MAX(1 - WORSTOF(Basket.yield), 0) \"Put vendu — perte en capital\""
      ],
      "version": "2.0"
    },
