      "script": [
        "UNDERLYING Basket",
        "",
        "# Autocall — rappel et coupon constatés sur la moyenne de la période",
        "# Chaque constatation moyenne ses relevés sur la période écoulée, par",
        "# sous-jacent, avant que WORSTOF(Basket.yield) n'agrège. La protection finale lit le cours de",
